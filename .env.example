# Public origin for canonical URLs and Open Graph.
# Local: http://localhost:3000
# Vercel preview: leave unset so the deployment uses VERCEL_URL.
# Do not set this to https://neurolinks.ca until DNS cutover.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engines. Leave unset (or any value other than true) for noindex/nofollow/noarchive.
# Only set to true after neurolinks.ca points at this app and the owner approves indexing.
# ALLOW_SEARCH_INDEXING=true

# Forms stay preview-only in code. There is no production adapter yet.
# Do not add Formidable, SMTP, or webhook secrets for this preview.
