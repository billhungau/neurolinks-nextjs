# Where this deployment answers requests. This is the one authoritative site URL:
# Payload's serverURL, the CMS session-cookie allowlist, preview links and the
# form CORS allowlist are all derived from it.
NEXT_PUBLIC_SITE_URL=https://neurolinks-nextjs.vercel.app

# Search engines. At launch, indexing needs BOTH NEXT_PUBLIC_SITE_URL=https://neurolinks.ca
# and ALLOW_SEARCH_INDEXING=true. Leave the flag unset on staging/preview.
# ALLOW_SEARCH_INDEXING=true
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_TMS_VIDEO_URL=
# NEXT_PUBLIC_KETAMINE_VIDEO_URL=

# Server-only forms.
JOTFORM_API_KEY=
JOTFORM_CONTACT_FORM_ID=
JOTFORM_REFERRAL_FORM_ID=262418577500054
# JOTFORM_REFERRAL_API_BASE_URL=https://api.jotform.com

# NeuroLinks Insights (Payload CMS). Server-only; never commit real values.
DATABASE_URL=
PAYLOAD_SECRET=
BLOB_READ_WRITE_TOKEN=

# Phase 1 AI Article Assistant. Server-only. The endpoint requires an authenticated
# Payload session and never publishes content. Do not prefix either variable with
# NEXT_PUBLIC_. OPENAI_CONTENT_MODEL is optional; the server has a default.
OPENAI_API_KEY=
# OPENAI_CONTENT_MODEL=gpt-5.6

# Public Insights listing and article URLs. Payload admin is independent of this flag.
# NEXT_PUBLIC_INSIGHTS_ENABLED=true
