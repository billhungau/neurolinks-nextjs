# Where this deployment answers requests. This is the one authoritative site URL:
# Payload's serverURL, the CMS session-cookie allowlist, preview links and the
# form CORS allowlist are all derived from it.
#
# Current staging target:
#   NEXT_PUBLIC_SITE_URL=https://neurolinks-nextjs.vercel.app
# At cutover, change it to https://neurolinks.ca on Production.
#
# This is NOT the canonical SEO origin. Canonical URLs, Open Graph URLs, JSON-LD
# and the sitemap always use https://neurolinks.ca so a staging deployment never
# advertises itself as the public site.
#
# When unset, the app falls back to https://$VERCEL_URL, then to
# http://localhost:$PORT for local development.
NEXT_PUBLIC_SITE_URL=https://neurolinks-nextjs.vercel.app

# Search engines. Leave unset (or any value other than true) for noindex/nofollow/noarchive
# on every host, including the Vercel production alias.
#
# Launch setting: indexing needs BOTH of these, so staging cannot be indexed even
# if this flag is copied into the wrong project:
#   1. NEXT_PUBLIC_SITE_URL=https://neurolinks.ca
#   2. ALLOW_SEARCH_INDEXING=true
# Set them only on Production, AFTER neurolinks.ca DNS points at this app.
# Preview and Development must never have this value, and VERCEL_ENV=production
# alone is not sufficient.
# ALLOW_SEARCH_INDEXING=true

# Optional HTML Search Console verification token. Do not invent a value.
# Preserve an existing Google token by pasting it here if the property uses
# HTML-tag verification rather than DNS.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional independent video hosting (Vercel Blob or another CDN). Required
# before WordPress is retired. When unset, the app uses a local public/ file
# if present, otherwise the current WordPress MP4.
# NEXT_PUBLIC_TMS_VIDEO_URL=
# NEXT_PUBLIC_KETAMINE_VIDEO_URL=

# Server-only Contact form → Jotform. Never prefix these with NEXT_PUBLIC_.
JOTFORM_API_KEY=
JOTFORM_CONTACT_FORM_ID=

# Server-only Physician Referral form → Jotform. Never prefix these with NEXT_PUBLIC_.
JOTFORM_REFERRAL_FORM_ID=262418577500054
# Optional. Use only a documented Jotform API host (standard, EU, or HIPAA).
# Do not include /form/... in this value.
# JOTFORM_REFERRAL_API_BASE_URL=https://api.jotform.com

# Cloudflare Turnstile or another persistent anti-spam layer is recommended
# if spam becomes a problem. This form is not rate-limited.

# NeuroLinks Insights (Payload CMS). All three are server-only. Never commit
# real values; set them in the Vercel project settings.

# PostgreSQL connection string. Use a managed database (Neon, Supabase, RDS) —
# never an ephemeral local database — for Preview and Production.
# Local development: postgres://neurolinks:neurolinks@127.0.0.1:5432/neurolinks
DATABASE_URL=

# Signing key for Payload sessions and preview links.
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel Blob read/write token for CMS image uploads. Created automatically
# when a Blob store is connected to the Vercel project. Without it, uploads
# fall back to the local filesystem, which is fine locally and wrong in
# production.
BLOB_READ_WRITE_TOKEN=

# Public Insights listing and article URLs. The /admin/ CMS is independent of
# this flag. Set to true only after at least one medically reviewed article is
# published.
# NEXT_PUBLIC_INSIGHTS_ENABLED=true
